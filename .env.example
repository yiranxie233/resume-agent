# Copy this file to .env. Never place cloud API keys or GitHub tokens here.
# If you change the PostgreSQL user/password/database in docker-compose.yml,
# update this URL as well (URL-encode special characters in the password).
POSTGRES_DB=resume_agent
POSTGRES_USER=resume
POSTGRES_PASSWORD=resume
POSTGRES_PORT=5433
RESUME_AGENT_DATABASE_URL=postgresql+psycopg://resume:resume@127.0.0.1:5433/resume_agent
RESUME_AGENT_DATA_ROOT=./data
RESUME_AGENT_API_HOST=127.0.0.1
RESUME_AGENT_API_PORT=8000
# Leave blank to let the backend generate data/.internal-token automatically.
RESUME_AGENT_INTERNAL_TOKEN=
# Optional absolute path to msedge.exe; blank enables automatic detection.
RESUME_AGENT_EDGE_PATH=
RESUME_AGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434
RESUME_AGENT_DEFAULT_CHAT_MODEL=qwen2.5:7b
RESUME_AGENT_DEFAULT_EMBEDDING_MODEL=bge-m3
RESUME_AGENT_TASK_TIMEOUT_SECONDS=300
RESUME_AGENT_STRICT_MODEL_GATE=true
RESUME_AGENT_EXTERNAL_MODEL_CONSENT_REQUIRED=true
RESUME_AGENT_LOG_RETENTION_DAYS=30
RESUME_AGENT_WORKER_LEASE_SECONDS=60
RESUME_AGENT_WORKER_HEARTBEAT_SECONDS=15
RESUME_AGENT_WORKER_TAKEOVER_GRACE_SECONDS=30
RESUME_AGENT_MCP_AUTOSTART=true
RESUME_AGENT_DATABASE_ECHO=false
RESUME_AGENT_DEBUG_MODEL_IO=false
